{
  "name": "sandbox-app-template",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --filter=@template/web --filter=@template/api",
    "dev:mobile": "cd packages/mobile && pnpm exec expo start --port 4300",
    "build": "turbo build",
    "build:web": "cd packages/web && pnpm run build",
    "start": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "stop": "pm2 delete web-app api 2>/dev/null || true",
    "kill:port": "pnpm run internal:kill-port",
    "lint": "pnpm run internal:check-conventions && oxlint . --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --deny-warnings --no-error-on-unmatched-pattern",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "internal:check-conventions": "konsistent",
    "internal:kill-port": "lsof -t -i :${PORT:-4200} | xargs kill -9"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "konsistent": "^1.0.0-beta.2",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "prisma": "^6.3.0",
    "semver": "^7.7.2",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@prisma/client": "^6.3.0",
    "cloudflare": "^5.2.0",
    "pm2": "^7.0.1"
  }
}
